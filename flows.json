    {
        "id": "0aac6441b3b29bc1",
        "type": "function",
        "z": "f5408950f28774a7",
        "name": "function 2",
        "func": "let datos = msg.payload || {};\n\nlet nombre = datos.nombre || \"\";\nlet telefono = datos.telefono || \"\";\n\nlet mensajeTelegram = {\n    payload: {\n        chatId: 8579685154,\n        type: \"message\",\n        content:\n`✅ Registro exitoso\n\nNombre: ${nombre}\nTeléfono: ${telefono}`\n    }\n};\n\nlet respuestaNavegador = {\n    req: msg.req,\n    res: msg.res,\n    headers: {\n        \"Content-Type\": \"text/html; charset=utf-8\"\n    },\n    payload:\n`<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Registro exitoso</title>\n</head>\n<body>\n    <h1>✅ Registro exitoso</h1>\n    <p>Gracias, ${nombre}.</p>\n    <p>Los datos fueron enviados correctamente.</p>\n</body>\n</html>`\n};\n\nreturn [respuestaNavegador, mensajeTelegram];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
